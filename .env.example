# zen-hub runtime config. Copy to .env.local (bootstrap writes the password
# there automatically on first start).

# --- listener -------------------------------------------------------------
# Loopback only. Change to 0.0.0.0 if you really want LAN access.
PROXY_HOST=127.0.0.1
# 8788 is taken by another local tool; 8790 is the default free choice.
PROXY_PORT=8790
# If PROXY_PORT is busy, try PROXY_PORT+1 .. PORT_FALLBACK_MAX instead of dying.
PORT_FALLBACK=true
PORT_FALLBACK_MAX=8799

# --- auth -----------------------------------------------------------------
# key = every client sends Authorization: Bearer <api key>
# off = no key required (accepts anything; only safe because we bind loopback)
AUTH_MODE=key
# Leave empty: the first start generates one into config.env.
ADMIN_PASSWORD=

# Open http://127.0.0.1:8790/app/ in the default browser after start.
# Also switchable in the console (设置 -> 访问与启动), which applies to the next start.
OPEN_CONSOLE=true

# Advertise the MEASURED context budgets (deepseek 1M / glm 786k) instead of the
# catalog 200k. Metadata only: requests are never blocked. Switch also lives in
# the console (设置 -> 上下文上限).
CONTEXT_UNLOCK=false

# --- egress ---------------------------------------------------------------
# UPSTREAM_PROXY=http://127.0.0.1:7897   # send everything through this proxy
# UPSTREAM_PROXY=direct                  # explicit direct connection (default)
UPSTREAM_PROXY=
PROXY_MODE=optional
OUTBOUND_PRE_PROXY_ENABLED=false
OUTBOUND_PRE_PROXY_URL=

# --- upstream -------------------------------------------------------------
ZEN_HOST=opencode.ai
ZEN_PATH=/zen/v1/chat/completions
ZEN_RESPONSES_PATH=/zen/v1/responses
ZEN_SYSTEMONE_PATH=/zen/v1/systemone
UPSTREAM_TIMEOUT_MS=120000

# --- limits ---------------------------------------------------------------
GLOBAL_REQUESTS_PER_MINUTE=120
API_KEY_REQUESTS_PER_MINUTE=60
API_KEY_MAX_CONCURRENT_REQUESTS=10
API_KEY_MAX_CONCURRENT_STREAMS=5
REDIS_URL=
REDIS_KEY_PREFIX=zen-hub:limit

# --- storage --------------------------------------------------------------
KEYS_FILE=./data/api-keys.json
MODELS_FILE=./data/models.json
MODEL_ALIASES_FILE=./data/model-aliases.json
SETTINGS_FILE=./data/settings.json
PROXIES_FILE=./data/proxies.json
LOGS_DIR=./data/logs
# true lets scripts/e2e.mjs read a key back; false keeps hashes only.
STORE_PLAINTEXT_API_KEYS=false
SHUTDOWN_DRAIN_TIMEOUT_MS=30000

# --- proxy pool (advanced, unused unless you add nodes) -------------------
PROXY_HEALTH_CHECK_MODEL=big-pickle
PROXY_HEALTH_CHECK_TIMEOUT_MS=10000
PROXY_RECOVERY_INTERVAL_MS=600000
PROXY_RECOVERY_CONCURRENCY=2
PROXY_RECOVERY_BATCH_SIZE=32
PROXY_COOLDOWN_MS=300000
PROXY_PERSIST_DEBOUNCE_MS=1000
PROXY_LARGE_POOL_WARNING_THRESHOLD=10000
